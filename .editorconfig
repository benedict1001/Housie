root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

[*.{aspx,ascx,master,config,csproj,sln,xml,json,js,css,scss,html,htm}]
indent_style = space
indent_size = 2
tab_width = 2
