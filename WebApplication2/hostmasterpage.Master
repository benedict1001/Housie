<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="hostmasterpage.master.cs" Inherits="WebApplication2.hostmasterpage" %><!DOCTYPE html><html><head runat="server">
    <title>Housie Host Portal</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        /* --- 1. Global Styles --- */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5;
            background-image: url('https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=1920&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            min-height: 100vh;
        }

        /* --- 2. Overlay --- */
        .master-overlay {
            background-color: rgba(255, 255, 255, 0.85);
            min-height: 100vh;
            width: 100%;
        }

        /* --- 3. Navbar Styling --- */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 15px 0;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
            margin-right: 2rem; /* Ensure spacing from links */
        }

        .nav-link {
            font-weight: 600;
            color: #64748b !important;
            margin: 0 10px;
            transition: 0.3s;
        }

        .nav-link:hover, .nav-link.active {
            color: #E61E4D !important;
        }

        .btn-logout {
            background-color: #E61E4D;
            color: white;
            border-radius: 20px;
            padding: 8px 20px;
            font-weight: 600;
            border: none;
            transition: 0.3s;
        }

        .btn-logout:hover {
            background-color: #be123c;
            color: white;
            transform: translateY(-2px);
        }

        .content-wrapper { padding: 40px 0; }

        .msg-nav-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 19px;
            height: 19px;
            padding: 0 5px;
            border-radius: 20px;
            background: linear-gradient(135deg, #E61E4D 0%, #D70466 100%);
            color: white;
            font-size: 11px;
            font-weight: 800;
            margin-left: 5px;
            box-shadow: 0 2px 6px rgba(230,30,77,0.4);
            vertical-align: middle;
            animation: badgePulse 2s ease-in-out infinite;
        }
        @keyframes badgePulse {
            0%, 100% { box-shadow: 0 2px 6px rgba(230,30,77,0.4); }
            50%       { box-shadow: 0 2px 10px rgba(230,30,77,0.7); }
        }
    </style></head><body>
    <form id="form1" runat="server">
        <div class="master-overlay">
            
            <nav class="navbar navbar-expand-lg fixed-top">
                <div class="container-fluid px-4">
                    <a class="navbar-brand" href="HostHome.aspx">
                        <span style="color: #E61E4D;">Housie</span><span style="color: #334155;">Host</span>
                    </a>
                    
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link" href="HostHome.aspx"><i class="fas fa-home me-1"></i> Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="add_property.aspx"><i class="fas fa-plus-circle me-1"></i> Add Property</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="hostbooking.aspx"><i class="fas fa-calendar-check me-1"></i> Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="hostprofile.aspx"><i class="fas fa-user-circle me-1"></i> My Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="hostmessages.aspx" style="position:relative;">
                                    <i class="fas fa-comment-dots me-1"></i> Messages
                                    <asp:Label ID="lblNavUnreadBadge" runat="server" CssClass="msg-nav-badge" Visible="false"></asp:Label>
                                </a>
                            </li>
                            <li class="nav-item ms-3">
                                <asp:LinkButton ID="LinkButtonLogout" runat="server" CssClass="btn btn-logout" OnClick="LinkButtonLogout_Click">
                                    Logout
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div style="height: 80px;"></div>

            <div class="content-wrapper">
                <div class="container">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>

            <footer class="text-center py-4 text-muted border-top mt-5">
                <small>&copy; 2026 Housie Host Platform. All rights reserved.</small>
            </footer>

        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>