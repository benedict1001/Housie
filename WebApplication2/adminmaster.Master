<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="adminmaster.Master.cs" Inherits="WebApplication2.Site1" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title>Housie Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f6f9;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        .sidebar {
            height: 100vh;
            width: 260px;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid #e0e0e0;
            padding-top: 20px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
        }

        .brand-section {
            padding: 0 25px 20px 25px;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 15px;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.8rem;
            color: #333;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .brand-highlight { color: #E61E4D; }

        .nav-pills .nav-link {
            color: #6c757d;
            font-weight: 500;
            padding: 10px 25px;
            margin-bottom: 2px;
            border-radius: 0;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            text-decoration: none;
            font-size: 0.9rem;
        }

        .nav-pills .nav-link:hover {
            background-color: #fff1f4;
            color: #E61E4D;
        }

        .nav-icon { margin-right: 12px; font-size: 1.1rem; }
        
        /* Section Labels */
        .sidebar-heading {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            color: #adb5bd;
            padding: 15px 25px 5px;
        }

        .main-content {
            margin-left: 260px;
            padding: 30px;
            min-height: 100vh;
        }

        @media (max-width: 768px) {
            .sidebar { margin-left: -260px; }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        
        <div class="sidebar">
            <div class="brand-section">
                <a class="navbar-brand" href="adminhomepage.aspx">
                    <img src="https://cdn-icons-png.flaticon.com/512/609/609803.png" width="35" height="35" alt="Logo" class="me-2">
                    Housie<span class="brand-highlight">.</span>
                </a>
                <small class="text-muted" style="font-size: 0.75rem; display: block; margin-left: 45px;">Admin Dashboard</small>
            </div>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="adminhomepage.aspx" class="nav-link">
                        <i class="bi bi-speedometer2 nav-icon"></i> Dashboard
                    </a>
                </li>

                <div class="sidebar-heading">Approvals Needed</div>
                <li class="nav-item">
                    <a href="hostapprovel.aspx" class="nav-link">
                        <i class="bi bi-person-plus nav-icon"></i> Host Requests
                    </a>
                </li>
                <li class="nav-item">
                    <a href="verifyproperties.aspx" class="nav-link">
                        <i class="bi bi-house-add nav-icon"></i> Property Verifications
                    </a>
                </li>

                <div class="sidebar-heading">Management</div>
                <li class="nav-item">
                    <a href="activehost.aspx" class="nav-link">
                        <i class="bi bi-people nav-icon"></i> Active Hosts
                    </a>
                </li>
                <li class="nav-item">
                    <a href="adminviewallproperty.aspx" class="nav-link">
                        <i class="bi bi-houses nav-icon"></i> Published Properties
                    </a>
                </li>
                <li class="nav-item">
                    <a href="propertytype.aspx" class="nav-link">
                        <i class="bi bi-grid nav-icon"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a href="district.aspx" class="nav-link">
                        <i class="bi bi-map nav-icon"></i> Locations
                    </a>
                </li>
                
                <li class="nav-item mt-auto border-top">
                    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="nav-link text-danger mt-2" OnClick="lnkLogout_Click" CausesValidation="false">
                        <i class="bi bi-box-arrow-right nav-icon"></i> Logout
                    </asp:LinkButton>
                </li>
            </ul>
        </div>

        <div class="main-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>

    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script type="text/javascript">
        // Listen for any key presses on the page
        document.addEventListener('keydown', function (event) {
            // Check if the user is pressing Ctrl + Shift + C
            if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === 'c') {
                event.preventDefault();
                // Redirect instantly to your customer page! 
                window.location.href = 'customerhomepage.aspx';
            }
        });
    </script>
     <script type="text/javascript">
         // Listen for any key presses on the page
         document.addEventListener('keydown', function (event) {
             // Check if the user is pressing Ctrl + Shift + H
             if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === 'h') {
                 event.preventDefault();
                 // Redirect instantly to your host page! 
                 window.location.href = 'hostloginform.aspx';
             }
         });
     </script>
</body>
</html>